# Copy to .env.local and fill in. Never commit .env.local.

# Postgres. Local dev: run `npm run db` (embedded Postgres on port 5433).
DATABASE_URL="postgresql://grahify:grahify-local-dev@localhost:5433/grahify"

# Auth.js session signing. Generate: openssl rand -base64 32
AUTH_SECRET=""

# AES-256-GCM key for birth data, charts, readings and journals (32 bytes, base64).
# Generate: openssl rand -base64 32. Losing it makes stored data unreadable.
ENCRYPTION_KEY=""

# Claude. Leave empty for preview mode (shows what Claude would be sent).
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"

# Email for magic links. Not set up yet: in development the link is shown on screen and logged.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM="Grahify <hello@your-domain>"
